PORT=5000
NODE_ENV=development

# MongoDB Connection:
# - DEVELOPMENT: Points to local MongoDB instance
MONGO_URI=mongodb://127.0.0.1:27017/college_placement_db

# JWT Configuration:
# - DEVELOPMENT: Use the sample secret below for local development.
# - PRODUCTION: You MUST supply a unique, cryptographically random secret (min 32 characters).
#   The server will reject known development secrets and fail fast when NODE_ENV=production.
#   Recommended generation:
#     Linux/macOS/Git Bash: openssl rand -base64 32
#     Node.js CLI:          node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Store in a secure secrets manager (e.g. AWS Secrets Manager, Doppler, Vault) or production environment variable.
#   NEVER commit actual production secrets to source control.
JWT_SECRET=cpms_secure_jwt_secret_key_2026_dev

# Dedicated Test Database (Optional override, defaults to mongodb://127.0.0.1:27017/college_placement_test_db):
# - NOTE: Tests will reject any database name not ending in _test or _test_db.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/college_placement_test_db
